# Backend settings for local development. Copy to .env at the repo root; both APIs
# (borrower-app/backend, admin-app/backend) read it, after their own .env if they have one.
# Production uses /etc/quickloan/*.env instead (deploy/env/, docs/deployment-runbook.md).

# Ports. The borrower API uses BORROWER_PORT, then PORT; the admin API uses ADMIN_PORT.
PORT=5000
# BORROWER_PORT=5000
# ADMIN_PORT=5100

# Must be set in production. Demo mode (fixed OTP 123456, staff role picker, demo user) is on unless
# NODE_ENV=production or DEMO_MODE=false.
JWT_SECRET=change-me
# NODE_ENV=production
# DEMO_MODE=false

# Database and uploads. Both APIs must point at the same paths, on the same machine (SQLite).
# Defaults: data/database.sqlite and data/uploads at the repo root.
# DB_PATH=./data/database.sqlite
# UPLOAD_DIR=./data/uploads
# Only one process creates the schema and seeds the terms: the borrower backend. The admin backend
# defaults to DB_INIT=false.
# DB_INIT=true

# How often the borrower backend checks for status changes made by staff (live status screen), in ms.
# SSE_POLL_MS=5000

# SMS (Twilio) and email (SMTP). Unset = messages are printed to the console instead.
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Behind a reverse proxy only: listen on localhost, and take visitor IPs from the proxy.
# LISTEN_HOST=127.0.0.1
# TRUST_PROXY=loopback

# Rate limits (per IP): applicant registration per hour, staff login per 15 minutes.
# FLOW_REGISTER_RATE_LIMIT=30
# STAFF_LOGIN_RATE_LIMIT=30
