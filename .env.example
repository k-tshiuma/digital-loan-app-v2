# Backend settings for local development. Copy to .env at the repo root; both APIs
# (borrower-app/backend, admin-app/backend) read it, after their own .env if they have one.
# Production uses /etc/quickloan/*.env instead (deploy/env/, docs/deployment-runbook.md).

# Ports. The borrower API uses BORROWER_PORT, then PORT; the admin API uses ADMIN_PORT.
PORT=5000
# BORROWER_PORT=5000
# ADMIN_PORT=5100

# Login token secrets. Locally JWT_SECRET (or nothing: a development value) is enough. In production each
# API needs its own: BORROWER_JWT_SECRET and ADMIN_JWT_SECRET, different from each other (deploy/env/).
# Demo mode (fixed OTP 123456, staff role picker, demo user) is on unless NODE_ENV=production or DEMO_MODE=false.
JWT_SECRET=change-me
# BORROWER_JWT_SECRET=
# ADMIN_JWT_SECRET=
# NODE_ENV=production
# DEMO_MODE=false
# The classic 9-step wizard skips the Back Office approvals, so the borrower API refuses classic drafts unless
# this is true. For local classic testing also set VITE_ENABLE_CLASSIC_FLOW=true in borrower-app/frontend/.env.
# ENABLE_CLASSIC_FLOW=true

# Database and uploads. Both APIs must point at the same paths, on the same machine (SQLite).
# Defaults: data/database.sqlite and data/uploads at the repo root.
# DB_PATH=./data/database.sqlite
# UPLOAD_DIR=./data/uploads
# Only one process creates the schema and seeds the terms: the borrower backend. The admin backend
# defaults to DB_INIT=false.
# DB_INIT=true

# How often the borrower backend checks for status changes made by staff (live status screen), in ms.
# SSE_POLL_MS=5000

# SMS (Twilio) and email (SMTP). Unset = messages are printed to the console instead.
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Browser sites allowed to call the APIs from another address. Default: the Vite dev servers (borrower API:
# localhost:3000, admin API: localhost:3001); none in production. Comma-separated.
# CORS_ORIGIN=

# Behind a reverse proxy only: listen on localhost, and take visitor IPs from the proxy.
# LISTEN_HOST=127.0.0.1
# TRUST_PROXY=loopback

# Funding partner ("Push to partner", admin API only; shared/backend/services/funding/config.js).
# In demo mode with none of these set, the admin API uses the local partner-bank sandbox: start it with
# `npm run partner:sandbox` (https://localhost:5300; it creates its test certificates on first start).
# FUNDING_PARTNER_URL=https://localhost:5300
# FUNDING_PARTNER_CODE=sandbox_bank
# FUNDING_PARTNER_NAME=Partner Bank (sandbox)
# FUNDING_PARTNER_CLIENT_ID=quickloan-sandbox
# FUNDING_PARTNER_CLIENT_SECRET=sandbox-secret-change-me
# FUNDING_PARTNER_CERT=./sandbox/partner-bank/certs/client.crt
# FUNDING_PARTNER_KEY=./sandbox/partner-bank/certs/client.key
# FUNDING_PARTNER_CA=./sandbox/partner-bank/certs/bank-ca.crt
# Per request (ms), tries per push for temporary errors, first wait between tries (ms, doubled each time),
# and how often hand-offs waiting for the partner are checked (ms, 0 = never).
# FUNDING_PARTNER_TIMEOUT_MS=20000
# FUNDING_MAX_ATTEMPTS=3
# FUNDING_RETRY_BASE_MS=1000
# FUNDING_POLL_MS=30000
# The sandbox's own settings (sandbox/partner-bank/server.js): port, client id and secret, allowed addresses,
# and how long its compliance review takes before it decides (ms).
# PARTNER_SANDBOX_PORT=5300
# PARTNER_SANDBOX_CLIENT_SECRET=sandbox-secret-change-me
# PARTNER_SANDBOX_ALLOWED_IPS=127.0.0.1,::1
# PARTNER_SANDBOX_REVIEW_MS=20000

# Rate limits (per IP): applicant registration per hour, staff login per 15 minutes.
# FLOW_REGISTER_RATE_LIMIT=30
# STAFF_LOGIN_RATE_LIMIT=30
