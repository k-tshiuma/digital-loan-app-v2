# Backend settings. Copy to .env. Both split backends (borrower-server.js, admin-server.js) read this file
# locally; in production give each process its own environment (docs/app-separation-plan.md, section 7).

# Ports. server.js (both portals in one process) and the borrower backend use PORT / BORROWER_PORT;
# the admin backend uses ADMIN_PORT.
PORT=5000
# BORROWER_PORT=5000
# ADMIN_PORT=5100

# Must be set in production. Demo mode (fixed OTP 123456, staff role picker, demo user) is on unless
# NODE_ENV=production or DEMO_MODE=false.
JWT_SECRET=change-me
# NODE_ENV=production
# DEMO_MODE=false

# Database and uploads. Both backends must point at the same paths, on the same machine (SQLite).
# DB_PATH=./database.sqlite
# UPLOAD_DIR=./uploads
# Only one process creates the schema and seeds the terms: the borrower backend. The admin backend
# defaults to DB_INIT=false.
# DB_INIT=true

# How often the borrower backend checks for status changes made by staff (live status screen), in ms.
# SSE_POLL_MS=5000

# SMS (Twilio) and email (SMTP). Unset = messages are printed to the console instead.
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Rate limits (per IP): applicant registration per hour, staff login per 15 minutes.
# FLOW_REGISTER_RATE_LIMIT=30
# STAFF_LOGIN_RATE_LIMIT=30
