# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Borrower app settings (build time).
# The borrower backend (borrower-server.js, or server.js). Default: http://localhost:5000/api
# VITE_API_URL=http://localhost:5000/api
# Where old /backoffice and /admin links are sent: the admin dashboard. Default: http://localhost:3001
# VITE_ADMIN_URL=http://localhost:3001
# Show the "classic wizard" link on the 3-step flow. The classic wizard skips the Back Office
# approvals, so keep it off for real applicants. Default: off (only "true" turns it on)
# VITE_ENABLE_CLASSIC_FLOW=true
