# /etc/quickloan/admin.env: admin API only. Wins over shared.env.
ADMIN_PORT=5100
# Signs staff login tokens; only this API has it. Must differ from BORROWER_JWT_SECRET.
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=<generate-a-different-long-random-secret>
# Only the borrower API creates the schema.
DB_INIT=false
# Staff login attempts per IP per 15 minutes.
STAFF_LOGIN_RATE_LIMIT=30
# Optional: only these addresses/networks may use the admin API (office, VPN), comma-separated, e.g.
# 203.0.113.0/24,198.51.100.7. Others get 403. Keep it the same as /etc/nginx/snippets/quickloan-admin-access.conf.
# Needs TRUST_PROXY=loopback (shared.env). Empty: no limit. A typo stops the API at start-up.
# ADMIN_ALLOWED_IPS=
