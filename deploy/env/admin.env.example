# /etc/quickloan/admin.env: admin API only. Wins over shared.env.
ADMIN_PORT=5100
# Signs staff login tokens; only this API has it. Must differ from BORROWER_JWT_SECRET.
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=<generate-a-different-long-random-secret>
# Only the borrower API creates the schema.
DB_INIT=false
# Staff login attempts per IP per 15 minutes.
STAFF_LOGIN_RATE_LIMIT=30
