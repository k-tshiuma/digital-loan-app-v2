# /etc/quickloan/admin.env: admin API only. Wins over shared.env.
ADMIN_PORT=5100
# Signs staff login tokens; only this API has it. Must differ from BORROWER_JWT_SECRET.
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=<generate-a-different-long-random-secret>
# Only the borrower API creates the schema.
DB_INIT=false
# Staff login attempts per IP per 15 minutes.
STAFF_LOGIN_RATE_LIMIT=30
# Optional: only these addresses/networks may use the admin API (office, VPN), comma-separated, e.g.
# 203.0.113.0/24,198.51.100.7. Others get 403. Keep it the same as /etc/nginx/snippets/quickloan-admin-access.conf.
# Needs TRUST_PROXY=loopback (shared.env). Empty: no limit. A typo stops the API at start-up.
# ADMIN_ALLOWED_IPS=

# Funding partner ("Push to partner"). Without these the Back Office shows "not set up" and nothing is sent.
# The partner gives the URL, the client id and secret, signs our client certificate and tells us its CA; it
# must also allow this server's outgoing IP address. Keep the key readable only by the quickloan user
# (chmod 600). With Docker, put the files in /etc/quickloan/funding/ (mounted read-only into admin-api).
# FUNDING_PARTNER_URL=https://api.partner-bank.example
# FUNDING_PARTNER_CODE=partner_bank
# FUNDING_PARTNER_NAME=Partner Bank
# FUNDING_PARTNER_CLIENT_ID=
# FUNDING_PARTNER_CLIENT_SECRET=
# FUNDING_PARTNER_CERT=/etc/quickloan/funding/client.crt
# FUNDING_PARTNER_KEY=/etc/quickloan/funding/client.key
# FUNDING_PARTNER_CA=/etc/quickloan/funding/partner-ca.crt
# FUNDING_POLL_MS=30000
