# /etc/quickloan/deploy.env: read by deploy/deploy.sh and deploy/backup.sh (plain shell variables).

# Public addresses. They are built into the frontends (links between the two sites).
PUBLIC_BORROWER_URL=https://app.example.com
PUBLIC_ADMIN_URL=https://admin.example.com

# Where nginx serves the built frontends from (deploy.sh copies each build here).
WEB_ROOT=/var/www/quickloan

# Must match DB_PATH and UPLOAD_DIR in shared.env.
DB_PATH=/var/lib/quickloan/database.sqlite
UPLOAD_DIR=/var/lib/quickloan/uploads

# Backups: where, and how many days to keep.
BACKUP_DIR=/var/backups/quickloan
BACKUP_KEEP_DAYS=14
