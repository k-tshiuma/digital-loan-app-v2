# /etc/quickloan/shared.env: settings both APIs use. Owner quickloan, chmod 600.
# Read by deploy/ecosystem.config.js (pm2). Per-API values go in borrower.env / admin.env.

NODE_ENV=production
# Demo mode is always off when NODE_ENV=production; this line only documents it.
DEMO_MODE=false

# Same secret for both APIs (staff and borrower tokens are told apart by their type claim).
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-a-long-random-secret>
# JWT_EXPIRES_IN=7d

# One database file and one uploads folder, on this machine's local disk (never a network share).
DB_PATH=/var/lib/quickloan/database.sqlite
UPLOAD_DIR=/var/lib/quickloan/uploads
# MAX_UPLOAD_BYTES=10485760

# The APIs sit behind nginx on the same machine: listen on localhost only, and take the visitor's
# address from nginx (rate limits and audit log IPs).
LISTEN_HOST=127.0.0.1
TRUST_PROXY=loopback

# SMS (login codes, status messages). Without these, messages are only logged, never sent.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Email. Without SMTP_USER, emails are only logged, never sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
