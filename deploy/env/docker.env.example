# /etc/quickloan/docker.env: the Docker deployment's own settings (docs/docker-deployment.md).
# Read by docker compose (--env-file) and deploy/docker/deploy.sh. The APIs' settings stay in shared.env,
# borrower.env and admin.env next to this file, as in the pm2 setup.

# The two site names (nginx server names, certificate folders under LETSENCRYPT_DIR/live/).
BORROWER_HOST=app.example.com
ADMIN_HOST=admin.example.com
# Public addresses, built into the frontends (links between the two sites).
PUBLIC_BORROWER_URL=https://app.example.com
PUBLIC_ADMIN_URL=https://admin.example.com

# Ports nginx is published on.
HTTP_PORT=80
HTTPS_PORT=443

# certbot's folder on the host (mounted read-only into nginx).
LETSENCRYPT_DIR=/etc/letsencrypt
# Folder with shared.env, borrower.env, admin.env and admin-access.conf. Default: this folder.
QUICKLOAN_ENV_DIR=/etc/quickloan
# Backups on the host (owner uid 1000, the containers' user), and how many days to keep.
BACKUP_DIR=/var/backups/quickloan
BACKUP_KEEP_DAYS=14
