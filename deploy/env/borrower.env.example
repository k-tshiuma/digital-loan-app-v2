# /etc/quickloan/borrower.env: borrower API only. Wins over shared.env.
BORROWER_PORT=5000
# Signs borrower login tokens; only this API has it. Generate with: openssl rand -hex 32
BORROWER_JWT_SECRET=<generate-a-long-random-secret>
# The borrower API owns the database schema and seeds the terms texts.
DB_INIT=true
# Applicant registrations per IP per hour.
FLOW_REGISTER_RATE_LIMIT=30
# How often open live-status screens are checked for staff changes, in ms.
SSE_POLL_MS=5000
# Leave unset in production: the classic wizard skips the Back Office approvals (off unless true).
# ENABLE_CLASSIC_FLOW=
